; COOLANT CIRCULATION - SIEMENS 840D SL / 828D
; STOP WITH RESET KEY
DEF REAL CL_ON_MIN, CL_OFF_MIN
DEF INT CL_REPEAT, CL_COUNT
;================================
; SETTINGS - CHANGE VALUES BELOW
;================================
CL_ON_MIN=1.0      ; COOLANT ON TIME (MIN)
CL_OFF_MIN=10.0    ; COOLANT OFF TIME (MIN)
CL_REPEAT=0        ; REPEAT COUNT, 0 = ENDLESS
;================================
; DO NOT EDIT BELOW THIS LINE
;================================
IF (CL_ON_MIN<=0) OR (CL_OFF_MIN<=0)
  MSG("CHECK CL_ON_MIN / CL_OFF_MIN")
  M0
  M30
ENDIF
IF CL_REPEAT<=0
  CL_REPEAT=99999999
ENDIF
CL_COUNT=0
M5
M9
MSG("COOLANT CIRCULATION RUNNING - RESET TO STOP")
WHILE CL_COUNT<CL_REPEAT
  M8
  G4 F=CL_ON_MIN*60
  M9
  G4 F=CL_OFF_MIN*60
  CL_COUNT=CL_COUNT+1
ENDWHILE
M9
MSG()
M30
